// model.grav — Model, the base of ActiveRecord-style classes, and Repository,
// the same operations for a class without that base.
//
//   class User extends Model {
//       public id: long = 0
//       public name: string = ""
//       public createdAt: DateTime? = null        // filled in on save
//       public updatedAt: DateTime? = null
//       fn posts() -> HasMany<Post> { return self.hasMany() }
//   }
//
//   DB.connect(Sqlite.open("app.db"))
//   let u = User.create(fields("name", "Ada"))   // INSERT; u.id filled in
//   u.name = "Ada L."
//   u.save()                                     // UPDATE
//   let back = User.find(u.id)                   // a User, or null
//   let busy = User.has("posts", ">=", 3).with("posts").latest().get()
//   u.delete()
import "std"
import "grav-db"
import "mapping.grav"
import "db.grav"
import "querylog.grav"
import "builder.grav"
import "relations.grav"
import "schema.grav"

namespace orbit {

    // A map of field values, for create, fill, where and the like:
    // `fields("name", "Ada", "age", 36)`.
    fn fields(...pairs: any) -> HashMap<string, any> {
        let m = new HashMap<string, any>();
        let n = pairs.length;
        if (n % 2 != 0) { throw new ValueError("fields takes names and values in pairs"); }
        let i = 0;
        while (i < n) {
            if (!(pairs[i] is string)) { throw new ValueError("fields: argument ${i + 1} should be a field name"); }
            m.put(pairs[i] as string, pairs[i + 1]);
            i += 2;
        }
        return m;
    }

    // Saving, loading and deleting objects of a mapped class (what Model,
    // Repository and Query share).
    class Persister {
        // A new object of the class with the row's columns in its fields; `at` is
        // where each field's column is in the row (Persister.positions), when known.
        static fn load(map: TableMap, row: Row, at: Array<int> = null) -> any {
            let obj = map.info.create();
            Persister.read(obj, map, row, at);
            if (obj is Model) { (obj as Model).__exists = true; }
            map.fire(ModelHook.Retrieved, obj);
            return obj;
        }
        // Where each of the class's fields is among `columns` (-1: not there), found
        // once for a whole result instead of by name in every row.
        static fn positions(map: TableMap, columns: Array<string>) -> Array<int> {
            let at = new Array<int>();
            for (m in map.fields) {
                let p = -1;
                for (i, c in columns) { if (c == m.column) { p = i; break; } }
                at.push(p);
            }
            return at;
        }
        // Copies the row's columns into `obj`'s fields (those the class maps).
        static fn read(obj: any, map: TableMap, row: Row, at: Array<int> = null) {
            let pos = at == null ? Persister.positions(map, row.columns()) : at;
            let model: Model = obj is Model ? obj as Model : null;
            let orig: Array<any> = model == null ? null : new Array<any>();
            for (m in map.fields) {
                let p = pos[m.index];
                if (p < 0) {
                    if (orig != null) { orig.push(m.columnValue(obj)); }
                    continue;
                }
                let v = row.at(p);
                let code = m.code;
                if (v != null && code != 0 && code < 4) {
                    if (code == 1 && !(v is Decimal)) { v = row.getDecimal(m.column); }
                    else if (code == 2 && !(v is JsonValue)) { v = row.getJson(m.column); }
                    else if (code == 3 && !(v is DateTime)) { v = row.getDateTime(m.column); }
                }
                m.setFromColumn(obj, v);
                if (orig != null) {
                    // The snapshot, as set (bools from 1/0 and so on); a string or a whole
                    // number goes in unchanged, so it is not read back.
                    let direct = m.cast != null || (code == 4 && v is string) || (code == 5 && v is long);
                    orig.push(direct ? v : m.field.get(obj));
                }
            }
            if (model != null) { model.__orig = orig; }
        }
        // Remembers `obj`'s field values as its row has them (for isDirty and saves of the changes only).
        static fn snapshot(obj: any, map: TableMap) {
            if (!(obj is Model)) { return; }
            let orig = new Array<any>();
            for (m in map.fields) { orig.push(m.columnValue(obj)); }   // (a cast field as its column has it: changes in place show)
            (obj as Model).__orig = orig;
        }
        // The fields whose values differ from the snapshot (all of them for an object that is not a Model).
        static fn dirty(obj: any, map: TableMap) -> Array<FieldMap> {
            let out = new Array<FieldMap>();
            let model: Model = obj is Model ? obj as Model : null;
            for (m in map.fields) {
                if (m.isId) { continue; }
                if (model == null || model.__orig == null ||
                    !Persister.same(model.__orig[m.index], m.columnValue(obj))) { out.push(m); }
            }
            return out;
        }
        // Whether two field values are the same (objects such as DateTime and Decimal by their text).
        static fn same(a: any, b: any) -> bool {
            if (a == null || b == null) { return a == null && b == null; }
            if (Object.equals(a, b)) { return true; }
            if (a is JsonValue && b is JsonValue) { return (a as JsonValue).toJson() == (b as JsonValue).toJson(); }
            if (a is Bytes && b is Bytes) { return (a as Bytes).toHex() == (b as Bytes).toHex(); }
            if (ClassInfo.of(a) != null && ClassInfo.of(a) == ClassInfo.of(b)) { return "${a}" == "${b}"; }
            return false;
        }
        // Sets fields from `values` (field names); with `mass`, @Guarded fields and a
        // numbered id are left out, as from user input.
        static fn fill(obj: any, map: TableMap, values: HashMap<string, any>, mass: bool) {
            for ((k, value) in values) {
                let m = map.find(k);
                if (m != null) {
                    if (mass && m.guarded) { continue; }
                    m.field.set(obj, value);
                    continue;
                }
                let p = map.info.property(k);                     // a setter (a mutator): set name(v) { ... }
                if (p != null && !p.isStatic() && !p.isPrivate() && !p.isProtected()) {
                    if (mass && p.has("Guarded")) { continue; }
                    if (p.isReadonly()) { throw new ValueError(map.info.simpleName() + "." + k + " is a read-only property"); }
                    p.set(obj, value);
                    continue;
                }
                let f = map.info.field(k);
                if (f == null) { throw new ValueError(map.info.simpleName() + " has no field or property '" + k + "'"); }
                f.set(obj, value);
            }
        }
        // Whether `obj` is not saved yet: its numbered id is still 0 (or null).
        static fn isNew(obj: any, map: TableMap) -> bool {
            if (map.id == null || !map.id.auto) { return obj is Model && !(obj as Model).__exists; }
            let v = map.id.field.get(obj);
            return v == null || (v is long && (v as long) == 0) || (v is int && (v as int) == 0);
        }
        // Inserts `obj` (filling in its id) or updates its row; createdAt and
        // updatedAt are set when the class has them.
        // A saved Model's changes go out alone (none: no UPDATE at all); `quiet`
        // runs no hooks (saveQuietly).
        static fn save(obj: any, map: TableMap, db: Connection, quiet: bool = false) {
            let now = DateTime.now();
            let model: Model = obj is Model ? obj as Model : null;
            if (!quiet) { map.fire(ModelHook.Saving, obj); if (model != null) { model.beforeSave(); } }
            if (Persister.isNew(obj, map)) {
                if (map.createdAt != null && map.createdAt.field.get(obj) == null) { map.createdAt.field.set(obj, now); }
                if (map.updatedAt != null) { map.updatedAt.field.set(obj, now); }
                if (!quiet) { map.fire(ModelHook.Creating, obj); if (model != null) { model.beforeCreate(); } }
                Persister.insert(obj, map, db);
                if (model != null && model.__ch != null) { model.__ch.clear(); }
                if (!quiet) { if (model != null) { model.afterCreate(); } map.fire(ModelHook.Created, obj); }
            } else {
                if (!quiet) { map.fire(ModelHook.Updating, obj); if (model != null) { model.beforeUpdate(); } }
                let changed = Persister.dirty(obj, map);
                if (model != null && model.__ch != null) { model.__ch.clear(); }
                if (!changed.isEmpty()) {
                    if (map.updatedAt != null) {
                        map.updatedAt.field.set(obj, now);
                        let has = false;
                        for (c in changed) { if (c == map.updatedAt) { has = true; } }
                        if (!has) { changed.push(map.updatedAt); }
                    }
                    if (Persister.update(obj, map, db, changed) == 0 && map.id != null && !map.id.auto) { Persister.insert(obj, map, db); }
                    if (model != null) { for (c in changed) { model.__changes().put(c.field.name, c.field.get(obj)); } }
                }
                if (!quiet) { if (model != null) { model.afterUpdate(); } map.fire(ModelHook.Updated, obj); }
            }
            Persister.snapshot(obj, map);
            if (!quiet) { if (model != null) { model.afterSave(); } map.fire(ModelHook.Saved, obj); Persister.touch(obj, map); }
        }
        // Touches ($touches): every row map.touches' relations match, by a raw
        // UPDATE of their updatedAt (Relation.touchAll — no load, no hooks on them).
        static fn touch(obj: any, map: TableMap) {
            if (map.touches.isEmpty() || !(obj is Model)) { return; }
            for (name in map.touches) {
                let mi = map.info.method(name);
                if (mi == null) { throw new StateError(map.info.simpleName() + " is @Touches(\"" + name + "\"), and it has no method '" + name + "'"); }
                let r = mi.invoke(obj, new Array<any>());
                if (!(r is Relation)) { throw new ValueError(map.info.simpleName() + "." + name + "() is not a relation"); }
                (r as Relation).touchAll();
            }
        }
        static fn insert(obj: any, map: TableMap, db: Connection) {
            let cols = new Array<string>();
            let marks = new Array<string>();
            let args = new Array<any>();
            let numbered = map.id != null && map.id.auto && Persister.isNew(obj, map);
            for (m in map.fields) {
                if (numbered && m.isId) { continue; }
                cols.push(db.quote(m.column));
                marks.push("?");
                args.push(m.columnValue(obj));
            }
            let sql = "INSERT INTO " + db.quote(map.table) +
                (cols.isEmpty() ? (db.driver() == "mysql" ? " () VALUES ()" : " DEFAULT VALUES") : " (" + Str.join(cols, ", ") + ") VALUES (" + Str.join(marks, ", ") + ")");
            if (numbered) {
                if (db.driver() == "postgres") { sql = sql + " RETURNING " + db.quote(map.id.column); }
                map.id.field.set(obj, Sql.insert(db, DB.nameFor(db), sql, args, map.table));
            } else {
                Sql.execute(db, DB.nameFor(db), sql, args, map.table);
            }
            if (obj is Model) { (obj as Model).__exists = true; }
        }
        // Updates `obj`'s row; how many rows it changed (0 when there is none with its id).
        static fn update(obj: any, map: TableMap, db: Connection, only: Array<FieldMap> = null) -> long {
            let id = map.requireId();
            let sets = new Array<string>();
            let args = new Array<any>();
            for (m in only == null ? map.fields : only) {
                if (m.isId) { continue; }
                sets.push(db.quote(m.column) + " = ?");
                args.push(m.columnValue(obj));
            }
            if (sets.isEmpty()) { return 0; }
            args.push(id.field.get(obj));
            return Sql.execute(db, DB.nameFor(db), "UPDATE " + db.quote(map.table) + " SET " + Str.join(sets, ", ") + " WHERE " + db.quote(id.column) + " = ?", args, map.table);
        }
        // Deletes `obj`'s row (with `force` even for a @SoftDeletes class); whether there was one.
        static fn delete(obj: any, map: TableMap, db: Connection, force: bool) -> bool {
            let id = map.requireId();
            map.fire(ModelHook.Deleting, obj);
            let goingThrough = force && map.softDelete != null;   // a forceDelete of an otherwise-soft-deletable row
            if (goingThrough) { map.fire(ModelHook.ForceDeleting, obj); }
            if (map.softDelete != null && !force) {
                map.softDelete.field.set(obj, DateTime.now());
                let marked = Persister.update(obj, map, db) > 0;
                Persister.snapshot(obj, map);
                map.fire(ModelHook.Deleted, obj);
                map.fire(ModelHook.Trashed, obj);
                return marked;
            }
            let args = new Array<any>();
            args.push(id.field.get(obj));
            let gone = Sql.execute(db, DB.nameFor(db), "DELETE FROM " + db.quote(map.table) + " WHERE " + db.quote(id.column) + " = ?", args, map.table) > 0;
            if (obj is Model) { (obj as Model).__exists = false; }
            map.fire(ModelHook.Deleted, obj);
            if (goingThrough) { map.fire(ModelHook.ForceDeleted, obj); }
            return gone;
        }
        // The field values of `obj` as a map (column values; @Hidden left out;
        // DateTime as ISO text, Decimal and the rest as they are), with its loaded relations.
        static fn toMap(obj: any, map: TableMap) -> HashMap<string, any> {
            let out = new HashMap<string, any>();
            let model0: Model = obj is Model ? obj as Model : null;
            for (m in map.fields) {
                let name = m.field.name;
                let hidden = m.hidden;
                if (model0 != null) {
                    if (model0.__sh != null && model0.__sh.contains(name)) { hidden = false; }
                    if (model0.__hd != null && model0.__hd.contains(name)) { hidden = true; }
                }
                if (!hidden) { out.put(name, m.field.get(obj)); }
            }
            for (p in map.appends) {                               // accessors: @Appended get fullName()
                let shown = !p.has("Hidden");
                if (model0 != null) {
                    if (model0.__sh != null && model0.__sh.contains(p.name)) { shown = true; }
                    if (model0.__hd != null && model0.__hd.contains(p.name)) { shown = false; }
                }
                if (shown) { out.put(p.name, p.get(obj)); }
            }
            if (model0 != null && model0.__sh != null) {             // append("x"): any other getter, for this object
                for (n in model0.__sh) {
                    if (out.containsKey(n) || map.find(n) != null) { continue; }
                    let p = map.info.property(n);
                    if (p != null && p.canGet() && !p.isStatic()) { out.put(n, p.get(obj)); }
                }
            }
            if (obj is Model) {
                let model = obj as Model;
                if (model.__ex != null) { for ((k, x) in model.__ex) { out.put(k, x); } }
                if (model.__nm != null) {
                    for ((k, key) in model.__nm) {
                        let v = model.__loaded().getOr(key + "#models", model.__loaded().getOr(key, null));   // (a list as Array<Model>)
                        out.put(k, Persister.plain(v));
                    }
                }
            }
            return out;
        }
        // A loaded relation's value for toMap: models as maps, lists of them as lists.
        static fn plain(v: any) -> any {
            if (v == null) { return null; }
            if (v is Model) { let m = v as Model; return Persister.toMap(m, TableMap.of(ClassInfo.of(m))); }
            if (v is Array<Model>) {
                let out = new Array<any>();
                for (x in v as Array<Model>) { out.push(Persister.plain(x)); }
                return out;
            }
            return v;
        }
        // A value as JSON.
        static fn json(v: any) -> JsonValue {
            if (v == null) { return Json.nil(); }
            if (v is bool) { return Json.of(v as bool); }
            if (v is long) { return Json.of(v as long); }
            if (v is int) { return Json.of((v as int) as long); }
            if (v is float) { return Json.of(v as float); }
            if (v is string) { return Json.of(v as string); }
            if (v is DateTime) { return Json.of((v as DateTime).iso()); }
            if (v is Decimal) { return Json.of((v as Decimal).toString()); }
            if (v is JsonValue) { return v as JsonValue; }
            if (v is Bytes) { return Json.of((v as Bytes).toHex()); }
            if (v is HashMap<string, any>) {
                let o = Json.object();
                let m = v as HashMap<string, any>;
                for ((k, x) in m) { o.set(k, Persister.json(x)); }
                return o;
            }
            if (v is Array<any>) {
                let a = Json.array();
                for (x in v as Array<any>) { a.push(Persister.json(x)); }
                return a;
            }
            return Json.of("${v}");
        }
    }

    // The base of a mapped class whose objects save and find themselves (see the
    // top of this file). Its static methods work on the class they are called
    // on: User.find(1) is a User.
    class Model {
        // (Internals: loaded relations by key, their names, extra columns a query
        // selected, whether the row exists for a class without a numbered id, the
        // field values the row has (by field position), and what the last save
        // changed. The maps are made when first needed: most objects never need them.)
        @Ignore public __ld: HashMap<string, any> = null
        @Ignore public __nm: HashMap<string, string> = null
        @Ignore public __ex: HashMap<string, any> = null
        @Ignore public __exists: bool = false
        @Ignore public __orig: Array<any> = null
        @Ignore public __ch: HashMap<string, any> = null
        @Ignore public __hd: Array<string> = null
        @Ignore public __sh: Array<string> = null
        // How many objects the query that read this one read together (N+1 detection: > 1).
        @Ignore public __batch: int = 0
        fn __loaded() -> HashMap<string, any> { if (self.__ld == null) { self.__ld = new HashMap<string, any>(); } return self.__ld; }
        fn __names() -> HashMap<string, string> { if (self.__nm == null) { self.__nm = new HashMap<string, string>(); } return self.__nm; }
        fn __extra() -> HashMap<string, any> { if (self.__ex == null) { self.__ex = new HashMap<string, any>(); } return self.__ex; }
        fn __changes() -> HashMap<string, any> { if (self.__ch == null) { self.__ch = new HashMap<string, any>(); } return self.__ch; }
        fn __hide() -> Array<string> { if (self.__hd == null) { self.__hd = new Array<string>(); } return self.__hd; }
        fn __show() -> Array<string> { if (self.__sh == null) { self.__sh = new Array<string>(); } return self.__sh; }

        // ── queries (each starts a Query of this class) ──────────────────────────
        static fn query() -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))); }
        static fn where(name: string, op: string, value: any) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).where(name, op, value); }
        static fn where(name: string, value: any) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).where(name, value); }
        static fn where(group: fn(Builder)) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).where(group); }
        static fn whereIn(name: string, values: Array<any>) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).whereIn(name, values); }
        static fn whereNotIn(name: string, values: Array<any>) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).whereNotIn(name, values); }
        static fn whereIn(name: string, sub: Builder) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).whereIn(name, sub); }
        static fn whereNotIn(name: string, sub: Builder) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).whereNotIn(name, sub); }
        static fn whereNull(name: string) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).whereNull(name); }
        static fn whereNotNull(name: string) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).whereNotNull(name); }
        static fn whereBetween(name: string, lo: any, hi: any) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).whereBetween(name, lo, hi); }
        static fn whereLike(name: string, pattern: string) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).whereLike(name, pattern); }
        static fn whereColumn(a: string, op: string, b: string) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).whereColumn(a, op, b); }
        static fn whereRaw(sql: string, args: Array<any> = new Array<any>()) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).whereRaw(sql, args); }
        static fn has(relation: string, op: string = ">=", count: int = 1) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).has(relation, op, count); }
        static fn doesntHave(relation: string) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).doesntHave(relation); }
        static fn whereHas(relation: string, f: fn(Builder)) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).whereHas(relation, f); }
        static fn whereDoesntHave(relation: string, f: fn(Builder)) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).whereDoesntHave(relation, f); }
        static fn with(relation: string) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).with(relation); }
        static fn with(relations: Array<string>) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).with(relations); }
        static fn withCount(relation: string) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).withCount(relation); }
        static fn withSum(relation: string, name: string) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).withSum(relation, name); }
        static fn withExists(relation: string) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).withExists(relation); }
        static fn whereRelation(relation: string, name: string, op: string, value: any) -> Query<Self> {
            return new Query<Self>(TableMap.of(reflect(Self))).whereRelation(relation, name, op, value);
        }
        static fn withoutScope(name: string) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).withoutScope(name); }
        static fn withoutScopes() -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).withoutScopes(); }
        static fn withAvg(relation: string, name: string) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).withAvg(relation, name); }
        static fn withMin(relation: string, name: string) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).withMin(relation, name); }
        static fn withMax(relation: string, name: string) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).withMax(relation, name); }
        static fn whereDate(name: string, op: string, value: any) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).whereDate(name, op, value); }
        static fn when(condition: bool, f: fn(Builder)) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).when(condition, f); }
        static fn withTrashed() -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).withTrashed(); }
        static fn onlyTrashed() -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).onlyTrashed(); }
        static fn select(names: Array<string>) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).select(names); }
        static fn orderBy(name: string, direction: string = "asc") -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).orderBy(name, direction); }
        static fn latest(name: string = "createdAt") -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).latest(name); }
        static fn oldest(name: string = "createdAt") -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).oldest(name); }
        static fn limit(n: long) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).limit(n); }
        static fn scope(name: string, args: Array<any> = new Array<any>()) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).scope(name, args); }
        static fn with(relation: string, f: fn(Builder)) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).with(relation, f); }
        static fn withWhereHas(relation: string, f: fn(Builder)) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).withWhereHas(relation, f); }
        static fn whereBelongsTo(owner: Model, relation: string = "") -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).whereBelongsTo(owner, relation); }
        static fn whereHasMorph(relation: string, types: Array<string>, f: fn(Builder)) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).whereHasMorph(relation, types, f); }
        static fn whereFullText(names: Array<string>, text: string) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).whereFullText(names, text); }
        static fn whereExists(sub: Builder) -> Query<Self> { return new Query<Self>(TableMap.of(reflect(Self))).whereExists(sub); }
        static fn cursor(f: fn(Self)) { new Query<Self>(TableMap.of(reflect(Self))).cursor(f); }
        static fn lazy(f: fn(Self), size: int = 1000) { new Query<Self>(TableMap.of(reflect(Self))).lazy(f, size); }
        // Every row, one at a time, read `size` at a time in id order: `for (u in User.iterate())`.
        static fn iterate(size: int = 1000) -> QueryIterator<Self> { return new QueryIterator<Self>(new Query<Self>(TableMap.of(reflect(Self))), size); }
        static fn simplePaginate(page: long = 1, perPage: long = 15) -> SimplePage<Self> { return new Query<Self>(TableMap.of(reflect(Self))).simplePaginate(page, perPage); }
        static fn cursorPaginate(perPage: long = 15, cursor: string = "") -> CursorPage<Self> { return new Query<Self>(TableMap.of(reflect(Self))).cursorPaginate(perPage, cursor); }

        // ── answers ──────────────────────────────────────────────────────────────
        static fn all() -> Array<Self> { return new Query<Self>(TableMap.of(reflect(Self))).get(); }
        static fn first() -> Self { return new Query<Self>(TableMap.of(reflect(Self))).first(); }
        static fn firstWhere(name: string, value: any) -> Self { return new Query<Self>(TableMap.of(reflect(Self))).firstWhere(name, value); }
        static fn firstWhere(name: string, op: string, value: any) -> Self { return new Query<Self>(TableMap.of(reflect(Self))).firstWhere(name, op, value); }
        static fn firstOrFail() -> Self { return new Query<Self>(TableMap.of(reflect(Self))).firstOrFail(); }
        static fn findOrNew(id: any) -> Self { return new Query<Self>(TableMap.of(reflect(Self))).findOrNew(id); }
        // Inserts rows, or updates the `update` fields of those whose `uniqueBy` fields match (see Builder.upsert).
        static fn upsert(rows: Array<HashMap<string, any>>, uniqueBy: Array<string>, update: Array<string>) -> long {
            return new Query<Self>(TableMap.of(reflect(Self))).upsert(rows, uniqueBy, update);
        }
        static fn insertOrIgnore(rows: Array<HashMap<string, any>>) -> long { return new Query<Self>(TableMap.of(reflect(Self))).insertOrIgnore(rows); }
        static fn chunkById(size: int, f: fn(Array<Self>)) { new Query<Self>(TableMap.of(reflect(Self))).chunkById(size, f); }
        // The object with id `id`, or null (a soft-deleted one too: null).
        static fn find(id: any) -> Self { return new Query<Self>(TableMap.of(reflect(Self))).find(id); }
        static fn findOrFail(id: any) -> Self { return new Query<Self>(TableMap.of(reflect(Self))).findOrFail(id); }
        static fn findMany(ids: Array<any>) -> Array<Self> { return new Query<Self>(TableMap.of(reflect(Self))).findMany(ids); }
        static fn count() -> long { return new Query<Self>(TableMap.of(reflect(Self))).count(); }
        static fn sum(name: string) -> Decimal { return new Query<Self>(TableMap.of(reflect(Self))).sum(name); }
        static fn avg(name: string) -> float { return new Query<Self>(TableMap.of(reflect(Self))).avg(name); }
        static fn min(name: string) -> any { return new Query<Self>(TableMap.of(reflect(Self))).min(name); }
        static fn max(name: string) -> any { return new Query<Self>(TableMap.of(reflect(Self))).max(name); }
        static fn pluck(name: string) -> Array<any> { return new Query<Self>(TableMap.of(reflect(Self))).pluck(name); }
        static fn paginate(page: long = 1, perPage: long = 15) -> Page<Self> { return new Query<Self>(TableMap.of(reflect(Self))).paginate(page, perPage); }
        static fn chunk(size: int, f: fn(Array<Self>)) { new Query<Self>(TableMap.of(reflect(Self))).chunk(size, f); }

        // ── making and changing ─────────────────────────────────────────────────
        // A new object with these fields set (not @Guarded ones), saved.
        static fn create(values: HashMap<string, any>) -> Self {
            let map = TableMap.of(reflect(Self));
            let obj = map.info.create() as Self;
            Persister.fill(obj, map, values, true);
            obj.save();
            return obj;
        }
        // A new object with these fields set, not saved.
        static fn make(values: HashMap<string, any>) -> Self {
            let map = TableMap.of(reflect(Self));
            let obj = map.info.create() as Self;
            Persister.fill(obj, map, values, true);
            return obj;
        }
        static fn firstOrCreate(attrs: HashMap<string, any>, values: HashMap<string, any> = new HashMap<string, any>()) -> Self {
            return new Query<Self>(TableMap.of(reflect(Self))).firstOrCreate(attrs, values);
        }
        static fn firstOrNew(attrs: HashMap<string, any>, values: HashMap<string, any> = new HashMap<string, any>()) -> Self {
            return new Query<Self>(TableMap.of(reflect(Self))).firstOrNew(attrs, values);
        }
        static fn updateOrCreate(attrs: HashMap<string, any>, values: HashMap<string, any>) -> Self {
            return new Query<Self>(TableMap.of(reflect(Self))).updateOrCreate(attrs, values);
        }
        // Deletes the objects with these ids; how many.
        static fn destroy(ids: Array<any>) -> long { return new Query<Self>(TableMap.of(reflect(Self))).whereKey(ids).delete(); }
        // Saves many new objects in one transaction.
        static fn saveAll(objs: Array<Self>) {
            let map = TableMap.of(reflect(Self));
            let db = DB.connection(map.connection);
            db.transaction(fn() { for (o in objs) { Persister.save(o, map, db); } });
        }

        // ── the table ────────────────────────────────────────────────────────────
        // Creates this class's table from its fields (when it does not exist yet).
        // Runs `o`'s hooks (saving, created, deleting, ...) for this class, and its
        // subclasses, alongside its decorator behaviors: `User.observe(new UserObserver())`.
        static fn observe(o: Behavior) { Observers.register(reflect(Self).name, o); }
        // One of many related rows to prune (see prune()).
        static fn prune(chunk: int = 1000) -> long {
            let map = TableMap.of(reflect(Self));
            let proto = map.info.create();
            let mi = map.info.method("prunable");
            if (mi == null) {
                throw new StateError(map.info.simpleName() + " is not prunable: define `fn prunable() -> Query<Self> { ... }`" +
                                     " (the rows prune() deletes for good)");
            }
            let hook = map.info.method("pruning");
            let done = new Array<bool>();                          // (a captured count can't be reassigned: push instead)
            (mi.invoke(proto, new Array<any>()) as Query<Self>).chunkById(chunk, fn(part: Array<Self>) {
                for (x in part) {
                    if (hook != null) { hook.invoke(x, new Array<any>()); }
                    (x as Model).forceDelete();
                    done.push(true);
                }
            });
            return done.size() as long;
        }
        static fn createTable() { let map = TableMap.of(reflect(Self)); Schema.createFor(map, DB.connection(map.connection)); }
        static fn dropTable() { let map = TableMap.of(reflect(Self)); DB.connection(map.connection).exec("DROP TABLE IF EXISTS " + DB.connection(map.connection).quote(map.table)); }
        // Deletes every row.
        static fn truncate() { let map = TableMap.of(reflect(Self)); let db = DB.connection(map.connection); Sql.execute(db, DB.nameFor(db), "DELETE FROM " + db.quote(map.table), new Array<any>(), map.table); }
        static fn tableName() -> string { return TableMap.of(reflect(Self)).table; }

        // ── this object ──────────────────────────────────────────────────────────
        // Inserts it (filling in its id) or, once saved, updates its row.
        fn save() -> Self {
            Persister.save(self, self.__map(), self.__db());
            return self;
        }
        // Saves without running hooks or behaviors' lifecycle code.
        fn saveQuietly() -> Self { Persister.save(self, self.__map(), self.__db(), true); return self; }

        // ── changes ──────────────────────────────────────────────────────────────
        // Whether a field (any, with no name) differs from its row.
        fn isDirty(name: string = "") -> bool {
            let map = self.__map();
            for (m in Persister.dirty(self, map)) { if (name == "" || m.field.name == name) { return true; } }
            return false;
        }
        fn isClean(name: string = "") -> bool { return !self.isDirty(name); }
        // The changed fields and their new values.
        fn getDirty() -> HashMap<string, any> {
            let out = new HashMap<string, any>();
            for (m in Persister.dirty(self, self.__map())) { out.put(m.field.name, m.field.get(self)); }
            return out;
        }
        // A field's value as its row had it (null when not loaded or saved).
        fn getOriginal(name: string) -> any {
            let m = self.__map().find(name);
            if (m == null || self.__orig == null) { return null; }
            let v = self.__orig[m.index];
            return m.cast == null || v == null ? v : m.cast.get(v);     // (the snapshot keeps a cast field as its column has it)
        }
        // What the last save changed, and whether it changed a field (any, with no name).
        fn getChanges() -> HashMap<string, any> { return self.__changes(); }
        fn wasChanged(name: string = "") -> bool { return name == "" ? !self.__changes().isEmpty() : self.__changes().containsKey(name); }
        // Takes the current values as the row's (nothing is dirty after).
        fn syncOriginal() -> Self { Persister.snapshot(self, self.__map()); return self; }
        // Sets these fields (not @Guarded ones) and saves.
        fn update(values: HashMap<string, any>) -> Self { Persister.fill(self, self.__map(), values, true); return self.save(); }
        // Sets these fields (not @Guarded ones), without saving.
        fn fill(values: HashMap<string, any>) -> Self { Persister.fill(self, self.__map(), values, true); return self; }
        // Deletes its row (for a @SoftDeletes class: marks it deleted); whether there was one.
        fn delete() -> bool {
            self.beforeDelete();
            let gone = Persister.delete(self, self.__map(), self.__db(), false);
            self.afterDelete();
            return gone;
        }
        // Deletes its row, even for a @SoftDeletes class.
        fn forceDelete() -> bool {
            self.beforeDelete();
            let gone = Persister.delete(self, self.__map(), self.__db(), true);
            self.afterDelete();
            return gone;
        }
        // Undoes a soft delete.
        fn restore() -> Self {
            let map = self.__map();
            if (map.softDelete == null) { throw new StateError(map.info.simpleName() + " is not @SoftDeletes"); }
            map.fire(ModelHook.Restoring, self);
            map.softDelete.field.set(self, null);
            if (map.updatedAt != null) { map.updatedAt.field.set(self, DateTime.now()); }
            Persister.update(self, map, self.__db());
            Persister.snapshot(self, map);
            map.fire(ModelHook.Restored, self);
            return self;
        }
        // Whether a soft delete marked it.
        fn trashed() -> bool { let sd = self.__map().softDelete; return sd != null && sd.field.get(self) != null; }
        // Reads its row again (NotFound when it is gone).
        fn refresh() -> Self {
            let map = self.__map();
            let row = new Builder(map, map.table, self.__db()).withTrashed().whereKey(map.requireId().field.get(self)).rows();
            if (row.size() == 0) { throw new NotFound("the " + map.info.simpleName() + " is no longer in " + map.table); }
            Persister.read(self, map, row.get(0));
            self.__loaded().clear();
            self.__names().clear();
            return self;
        }
        // Adds `by` to a field, in the object and its row (decrement subtracts).
        fn increment(name: string, by: long = 1) -> Self { return self.bump(name, by); }
        fn decrement(name: string, by: long = 1) -> Self { return self.bump(name, 0 - by); }
        // Saves it with updatedAt set to now.
        fn touch() -> Self {
            let map = self.__map();
            if (map.updatedAt == null) { return self; }
            map.updatedAt.field.set(self, DateTime.now());       // (dirty now, so the save writes it)
            return self.save();
        }
        // Whether it is not saved yet.
        fn isNew() -> bool { return Persister.isNew(self, self.__map()); }
        // Whether `other` is the same row (same class and id).
        fn isSame(other: Model) -> bool {
            if (other == null || ClassInfo.of(other) != ClassInfo.of(self)) { return false; }
            let id = self.__map().id;
            return id != null && Object.equals(id.field.get(self), id.field.get(other));
        }
        // A copy without its id (not saved): cast it to the class (`u.replicate() as User`).
        fn replicate() -> Model {
            let map = self.__map();
            let copy = map.info.create() as Model;
            for (m in map.fields) { if (!m.isId) { m.field.set(copy, m.field.get(self)); } }
            return copy;
        }
        // Loads `relation` now (as with() does for a query).
        fn load(relation: string) -> Self {
            let list = new Array<Model>();
            list.push(self);
            Relation.eagerLoad(list, relation);
            return self;
        }
        // Loads `relation` now, narrowed by `f` (as with(relation, f)).
        fn load(relation: string, f: fn(Builder)) -> Self {
            let list = new Array<Model>();
            list.push(self);
            Relation.eagerLoad(list, relation, f);
            return self;
        }
        // Loads `relation` unless it is loaded already.
        fn loadMissing(relation: string) -> Self { if (!self.relationLoaded(relation)) { self.load(relation); } return self; }
        // Counts `relation` now (countOf reads it), as withCount does for a query.
        fn loadCount(relation: string) -> Self {
            let map = self.__map();
            let q = new Builder(map, map.table, self.__db()).withTrashed().whereKey(map.requireId().field.get(self)).withCount(relation);
            let rows = q.rows();
            let key = Naming.snake(relation) + "_count";
            if (rows.size() > 0) { self.__extra().put(key, rows.get(0).get(key)); }
            return self;
        }
        // Saves it and every loaded related object (one level down, and theirs in turn).
        fn push() -> Self {
            self.save();
            for (key in self.__names().values()) {
                let v = self.__loaded().getOr(key + "#models", self.__loaded().getOr(key, null));
                if (v is Model) { (v as Model).push(); }
                else if (v is Array<Model>) { for (m in v as Array<Model>) { m.push(); } }
            }
            return self;
        }
        // Whether `relation` is loaded.
        fn relationLoaded(relation: string) -> bool { return self.__names().containsKey(relation); }
        // A count withCount added (`countOf("posts")` for posts_count), or 0.
        fn countOf(relation: string) -> long { return Builder.toLong(self.__extra().getOr(Naming.snake(relation) + "_count", 0)); }
        // A column the query selected beyond the fields (selectRaw, withCount, a pivot's columns).
        fn extra(name: string) -> any { return self.__extra().getOr(name, null); }
        // A pivot column of a many-to-many link this object was read through (`pivot("level")`).
        fn pivot(name: string) -> any { return self.__extra().getOr("pivot_" + name, null); }
        // Its fields (not @Hidden), and its loaded relations.
        fn toMap() -> HashMap<string, any> { return Persister.toMap(self, self.__map()); }
        // Hides (or shows, though @Hidden) these fields in this object's toMap and toJson.
        fn makeHidden(names: Array<string>) -> Self { for (n in names) { self.__hide().push(n); } return self; }
        // Puts these properties' getters (accessors) into its toMap and toJson too.
        fn append(names: Array<string>) -> Self { return self.makeVisible(names); }
        fn makeVisible(names: Array<string>) -> Self {
            for (n in names) { self.__show().push(n); self.__hide().remove(n); }
            return self;
        }
        // Just these fields (by name), or all but these, as a map.
        fn only(names: Array<string>) -> HashMap<string, any> {
            let all = Persister.toMap(self, self.__map());
            let out = new HashMap<string, any>();
            for (n in names) { if (all.containsKey(n)) { out.put(n, all[n]); } }
            return out;
        }
        fn except(names: Array<string>) -> HashMap<string, any> {
            let all = Persister.toMap(self, self.__map());
            for (n in names) { all.remove(n); }
            return all;
        }
        fn toJson() -> string { return Persister.json(self.toMap()).toJson(); }

        // ── relations (return them from methods: see relations.grav) ────────────
        // The T objects whose `foreignKey` (default: this class's name, snake_case, + "_id") is this one's id.
        fn hasMany<T>(foreignKey: string = "", localKey: string = "") -> HasMany<T> { return new HasMany<T>(self, foreignKey, localKey); }
        fn hasOne<T>(foreignKey: string = "", localKey: string = "") -> HasOne<T> { return new HasOne<T>(self, foreignKey, localKey); }
        // The T this one's `foreignKey` (default: T's name, snake_case, + "_id") names.
        fn belongsTo<T>(foreignKey: string = "", ownerKey: string = "") -> BelongsTo<T> { return new BelongsTo<T>(self, foreignKey, ownerKey); }
        // T objects linked through a pivot table (default: both names, snake_case, in alphabetical order: "role_user").
        fn belongsToMany<T>(table: string = "", foreignPivotKey: string = "", relatedPivotKey: string = "") -> BelongsToMany<T> {
            return new BelongsToMany<T>(self, table, foreignPivotKey, relatedPivotKey, "", false);
        }
        // The T objects reached through U objects (HasManyThrough), or the one (HasOneThrough).
        fn hasManyThrough<T, U>(firstKey: string = "", secondKey: string = "", localKey: string = "", secondLocalKey: string = "") -> HasManyThrough<T, U> {
            return new HasManyThrough<T, U>(self, firstKey, secondKey, localKey, secondLocalKey);
        }
        fn hasOneThrough<T, U>(firstKey: string = "", secondKey: string = "", localKey: string = "", secondLocalKey: string = "") -> HasOneThrough<T, U> {
            return new HasOneThrough<T, U>(self, firstKey, secondKey, localKey, secondLocalKey);
        }
        // Polymorphic: the T objects whose `<name>_id` and `<name>_type` point here.
        fn morphMany<T>(name: string) -> MorphMany<T> { return new MorphMany<T>(self, name); }
        fn morphOne<T>(name: string) -> MorphOne<T> { return new MorphOne<T>(self, name); }
        // Polymorphic: the object `<name>_type` and `<name>_id` point to (any mapped class).
        fn morphTo(name: string) -> MorphTo { return new MorphTo(self, name); }
        // Polymorphic many-to-many through `<name>s` ("taggables"): T objects linked
        // to this one, and (morphedByMany) the T objects linked to a tag.
        fn morphToMany<T>(name: string, table: string = "") -> BelongsToMany<T> { return new BelongsToMany<T>(self, table, "", "", name, false); }
        fn morphedByMany<T>(name: string, table: string = "") -> BelongsToMany<T> { return new BelongsToMany<T>(self, table, "", "", name, true); }

        // ── hooks (override them; throw to stop the change) ─────────────────────
        fn beforeSave() {}
        fn afterSave() {}
        fn beforeCreate() {}
        fn afterCreate() {}
        fn beforeUpdate() {}
        fn afterUpdate() {}
        fn beforeDelete() {}
        fn afterDelete() {}

        // (Internals.)
        // Keeps a loaded list also as models, for toMap and toJson (an Array<Post> is not an Array<Model>).
        fn __keepList(key: string, models: Array<Model>) { self.__loaded().put(key + "#models", models); }
        // Forgets a loaded relation (it changed): its values and the names it was loaded under.
        fn __forget(key: string) {
            self.__loaded().remove(key);
            self.__loaded().remove(key + "#models");
            let gone = new Array<string>();
            for ((n, k) in self.__names()) { if (k == key) { gone.push(n); } }
            for (n in gone) { self.__names().remove(n); }
        }
        fn __map() -> TableMap { return TableMap.of(ClassInfo.of(self)); }
        fn __db() -> Connection { return DB.connection(self.__map().connection); }
        private fn bump(name: string, by: long) -> Self {
            let map = self.__map();
            let m = map.find(name);
            if (m == null) { throw new ValueError(map.info.simpleName() + " has no field '" + name + "'"); }
            let now = m.field.get(self);
            let n = now is long ? now as long : now is int ? (now as int) as long : 0;
            m.field.set(self, n + by);
            new Builder(map, map.table, self.__db()).withTrashed().whereKey(map.requireId().field.get(self)).increment(name, by);
            if (self.__orig != null) { self.__orig[m.index] = n + by; }   // (the row has it now: not dirty)
            if (map.updatedAt != null) {
                let stamp = DateTime.now();
                map.updatedAt.field.set(self, stamp);
                if (self.__orig != null) { self.__orig[map.updatedAt.index] = stamp; }
            }
            return self;
        }
    }

    // Saving and finding objects of class T on a given connection, for classes
    // that do not extend Model (or another database than the default).
    class Repository<T> {
        private map: TableMap
        private db: Connection

        constructor(db: Connection) { self.db = db; self.map = TableMap.of(reflect(T)); }

        fn query() -> Query<T> { let q = new Query<T>(self.map); q.on(self.db); return q; }
        fn where(name: string, op: string, value: any) -> Query<T> { return self.query().where(name, op, value); }
        fn where(name: string, value: any) -> Query<T> { return self.query().where(name, value); }
        fn all() -> Array<T> { return self.query().get(); }
        fn find(id: any) -> T { return self.query().find(id); }
        fn findOrFail(id: any) -> T { return self.query().findOrFail(id); }
        fn count() -> long { return self.query().count(); }
        // Inserts or updates `obj`.
        fn save(obj: T) -> T { Persister.save(obj, self.map, self.db); return obj; }
        // Saves each of `objs`, in one transaction.
        fn saveAll(objs: Array<T>) {
            let map = self.map;
            let db = self.db;
            db.transaction(fn() { for (o in objs) { Persister.save(o, map, db); } });
        }
        fn delete(obj: T) -> bool { return Persister.delete(obj, self.map, self.db, false); }
        fn createTable() { Schema.createFor(self.map, self.db); }
        fn dropTable() { self.db.exec("DROP TABLE IF EXISTS " + self.db.quote(self.map.table)); }
        fn tableName() -> string { return self.map.table; }
    }
}
