// db.grav — DB: the connections Orbit uses, transactions, raw statements, and
// queries on tables without a model.
//
//   DB.connect(Sqlite.open("app.db"))                // the default connection
//   DB.connect(MySql.open(url), "reports")           // a named one (@Connection("reports") on a model)
//   DB.connect(MySql.open(writeUrl), MySql.open(readUrl))   // reads go to the replica
//   DB.transaction(fn() { ... })                     // committed, or rolled back when it throws
//   DB.transaction(fn() { ... }, 3)                  // retried on a deadlock, up to 3 times
//   DB.beginTransaction(); ...; DB.commit()          // or DB.rollBack()
//   let rows = DB.select("SELECT * FROM users WHERE age > ?", [18])
//   let names = DB.table("users").where("age", ">", 18).orderBy("name").pluck("name")
import "std"
import "grav-db"
import "mapping.grav"
import "builder.grav"
import "querylog.grav"

namespace orbit {

    // The database connections, transactions and raw SQL (see the top of this file).
    class DB {
        private static named: HashMap<string, Connection> = new HashMap<string, Connection>()

        private static reads: HashMap<string, Connection> = new HashMap<string, Connection>()

        // Makes `db` the connection called `name` ("default": what models use).
        static fn connect(db: Connection, name: string = "default") { DB.named.put(name, db); }
        // Makes `write` the connection reads go to too, but `read` the one `select`,
        // `selectOne`, `scalar` and a query's reading methods use instead (a read
        // replica): until a transaction opens, when they go back to `write` (its
        // replica may not have the transaction's own writes yet).
        static fn connect(write: Connection, read: Connection, name: string = "default") {
            DB.named.put(name, write);
            DB.reads.put(name, read);
        }
        // The connection reads use: `read` while none is in a transaction, else `write`.
        static fn readConnection(name: string = "default") -> Connection {
            let key = name == "" ? "default" : name;
            let w = DB.connection(key);
            let r = DB.reads.getOr(key, null);
            return r == null || w.inTransaction() || r.inTransaction() ? w : r;
        }
        // Whether `db` is `name`'s read replica (for the query log).
        static fn isReplica(db: Connection, name: string = "default") -> bool {
            return db != DB.connection(name);
        }
        // The connection called `name`; StateError when there is none.
        static fn connection(name: string = "default") -> Connection {
            let key = name == "" ? "default" : name;
            let db = DB.named.getOr(key, null);
            if (db == null) {
                throw new StateError(key == "default" ? "no database for Orbit: call DB.connect(db) first"
                    : "no database connection called '" + key + "': DB.connect(db, \"" + key + "\")");
            }
            return db;
        }
        // Whether a connection called `name` is set.
        static fn hasConnection(name: string = "default") -> bool { return DB.named.containsKey(name == "" ? "default" : name); }
        // Forgets the connection called `name` (closing it is yours; its read
        // replica too, if `connect` gave one).
        static fn disconnect(name: string = "default") {
            DB.named.remove(name);
            DB.reads.remove(name);
        }

        // ── the query log ────────────────────────────────────────────────────────
        // Keeps every statement Orbit runs from now on (the newest Sql.logLimit, 10000).
        static fn enableQueryLog() { Sql.enableLog(); }
        static fn disableQueryLog() { Sql.disableLog(); }
        static fn logging() -> bool { return Sql.logEnabled(); }
        // What the log kept, oldest first.
        static fn getQueryLog() -> Array<QueryEvent> { return Sql.entries(); }
        static fn flushQueryLog() { Sql.clearLog(); }
        // Calls `f` after every statement Orbit runs (also while the log is off).
        static fn listen(f: fn(QueryEvent)) { Sql.listen(f); }
        static fn forgetListeners() { Sql.forgetListeners(); }

        // ── transactions ─────────────────────────────────────────────────────────
        // Runs `body` in a transaction: committed when it returns, rolled back when
        // it throws (and the exception goes on). Nested, it is a savepoint.
        static fn transaction(body: fn()) { DB.transaction("default", body); }
        static fn transaction(name: string, body: fn()) {
            let db = DB.connection(name);
            try { db.transaction(body); } catch (e: Exception) { if (!db.inTransaction()) { Sql.ended(DB.key(name)); } throw e; }
            if (!db.inTransaction()) { Sql.ended(DB.key(name)); }
        }
        // Retries `body` up to `attempts` times, rolling back and running it again
        // when it fails on a deadlock or a serialization failure (see isDeadlock);
        // any other error, or the last attempt's, goes on. Each retry waits a
        // little longer than the last.
        static fn transaction(body: fn(), attempts: int) -> void { DB.transaction("default", body, attempts); }
        static fn transaction(name: string, body: fn(), attempts: int) {
            for (i in 0..attempts) {
                try { DB.transaction(name, body); return; }
                catch (e: DbError) {
                    if (i + 1 >= attempts || !DB.isDeadlock(e, name)) { throw e; }
                    Time.sleepMs(20 * (i + 1));
                }
            }
        }
        // Whether `e` is the database reporting a deadlock or a transaction
        // conflict (worth retrying), rather than a real error in the statement:
        // PostgreSQL's or MySQL's SQLSTATE for one (40001 serialization failure,
        // 40P01 deadlock_detected), MySQL's own deadlock/lock-wait-timeout codes
        // (1213, 1205), or, for SQLite (which has no SQLSTATE), SQLITE_BUSY or
        // SQLITE_LOCKED (5, 6, and their extended codes) on the connection named `name`. Pass no name (or one
        // with no connection) to check only the driver-agnostic SQLSTATEs.
        static fn isDeadlock(e: DbError, name: string = "") -> bool {
            if (e.state == "40001" || e.state == "40P01") { return true; }
            let driver = name != "" && DB.hasConnection(name) ? DB.connection(name).driver() : "";
            // (grav-db reports SQLite's extended codes — 517 SQLITE_BUSY_SNAPSHOT, 261
            // SQLITE_BUSY_RECOVERY, 262 SQLITE_LOCKED_SHAREDCACHE...: the low byte is the primary one.)
            if (driver == "sqlite") { let primary = e.code & 0xFF; return primary == 5 || primary == 6; }
            if (driver == "mysql" || driver == "") { return e.code == 1213 || e.code == 1205; }
            return false;
        }
        // Starts a transaction (a savepoint inside one), to end with commit or rollBack.
        static fn beginTransaction(name: string = "default") { DB.connection(name).begin(); }
        static fn commit(name: string = "default") { let db = DB.connection(name); db.commit(); if (!db.inTransaction()) { Sql.ended(DB.key(name)); } }
        static fn rollBack(name: string = "default") { let db = DB.connection(name); db.rollback(); if (!db.inTransaction()) { Sql.ended(DB.key(name)); } }
        // Whether a transaction is open.
        static fn inTransaction(name: string = "default") -> bool { return DB.connection(name).inTransaction(); }

        // ── raw SQL (with `?` arguments) ─────────────────────────────────────────
        // Reads go to the read connection (readConnection), writes to the write one.
        static fn select(sql: string, args: Array<any> = new Array<any>()) -> ResultSet {
            let db = DB.readConnection();
            return Sql.query(db, "default", sql, args, DB.isReplica(db));
        }
        static fn selectOne(sql: string, args: Array<any> = new Array<any>()) -> Row {
            let db = DB.readConnection();
            return Sql.queryOne(db, "default", sql, args, DB.isReplica(db));
        }
        // The first column of the first row, or null.
        static fn scalar(sql: string, args: Array<any> = new Array<any>()) -> any {
            let db = DB.readConnection();
            return Sql.queryValue(db, "default", sql, args, DB.isReplica(db));
        }
        // Runs an INSERT; the new row's id. (Raw writes drop every cached result of
        // the connection: Orbit cannot tell which tables they change.)
        static fn insert(sql: string, args: Array<any> = new Array<any>()) -> long { return Sql.insert(DB.connection(), "default", sql, args, ""); }
        // Runs an UPDATE or DELETE; the rows it changed.
        static fn update(sql: string, args: Array<any> = new Array<any>()) -> long { return Sql.execute(DB.connection(), "default", sql, args, ""); }
        static fn delete(sql: string, args: Array<any> = new Array<any>()) -> long { return Sql.execute(DB.connection(), "default", sql, args, ""); }
        // Runs any statement; the rows it changed.
        static fn statement(sql: string, args: Array<any> = new Array<any>()) -> long { return Sql.execute(DB.connection(), "default", sql, args, ""); }
        // Runs statements without arguments (a script).
        static fn unprepared(sql: string) { Sql.exec(DB.connection(), "default", sql); }
        // The DB name `db` is connected under (a replica: its write connection's
        // name; an unnamed one: "@" and a number), for the query log and cache.
        static fn nameOf(db: Connection) -> string {
            for (k in DB.named.keys()) { if (DB.named[k] == db) { return k; } }
            for (k in DB.reads.keys()) { if (DB.reads[k] == db) { return k; } }
            return Sql.anonymous(db);
        }
        // nameOf, only while something needs it (the log, the cache, sticky reads); "" otherwise.
        static fn nameFor(db: Connection) -> string { return Sql.busy() ? DB.nameOf(db) : ""; }
        // The DB name a query names ("" is "default").
        static fn key(name: string) -> string { return name == "" ? "default" : name; }

        // A query on table `name`, without a model: its rows come back as Rows.
        static fn table(name: string) -> TableQuery { return new TableQuery(name, DB.connection()); }
        // Adds every retryable DbError's class to the recognized set is unnecessary:
        // isDeadlock covers the common drivers. Advanced users can retry by hand:
        // `try { DB.transaction(body) } catch (e: DbError) { if (DB.isDeadlock(e)) { ... } }`.
    }
}
