// behaviors.grav — model traits: code a class gets by wearing a decorator, as
// @SoftDeletes gives soft deletes. Write one by extending Behavior, register it
// under its decorator's name, and put that decorator on any model (or on a base
// class: its subclasses wear it too).
//
//   class Sluggable extends Behavior {
//       // Before each save: slug = the source field (@Sluggable("title")), lower-case, dashed.
//       fn saving(m: Model, d: Decorator) {
//           let info = ClassInfo.of(m)
//           let text = "${info.field(d.text(0)).get(m)}"
//           info.field("slug").set(m, Str.replace(Str.lower(Str.trim(text)), " ", "-"))
//       }
//   }
//   class Published extends Behavior {
//       // A global scope: every query of the class sees only published rows.
//       fn apply(q: Builder, map: TableMap, d: Decorator) { q.where("published", true) }
//   }
//
//   Behaviors.register("Sluggable", new Sluggable())
//   Behaviors.register("Published", new Published())
//
//   @Sluggable("title") @Published
//   class Article extends Model { public id: long = 0; public title: string = ""; public slug: string = ""; public published: bool = false }
//
//   Article.withoutScope("Published").count()     // every article
//
// Built in: SoftDeletes, Timestamps (on unless @NoTimestamps) and Uuids
// (@Uuids, or @Uuids("field"): a new row gets a random UUID there). The traits in
// traits.grav bring each one with its fields: `class Post extends Model implements SoftDeletes`.
import "std"
import "mapping.grav"
import "builder.grav"
import "model.grav"

namespace orbit {

    // A model trait (see the top of this file). Each hook gets the model and the
    // decorator that put the behavior on its class (for its arguments); override
    // the ones you need. Throw from a "-ing" hook to stop the change.
    abstract class Behavior {
        // Once, when a class wearing it is first used: change its mapping.
        fn boot(map: TableMap, d: Decorator) {}
        // A global scope: conditions every query of the class gets
        // (`withoutScope("Name")` on a query drops it, `withoutScopes()` all).
        fn apply(q: Builder, map: TableMap, d: Decorator) {}
        // Whether apply() may add conditions: false lets every query skip it.
        fn scopes() -> bool { return true }
        fn saving(m: Model, d: Decorator) {}
        fn saved(m: Model, d: Decorator) {}
        fn creating(m: Model, d: Decorator) {}
        fn created(m: Model, d: Decorator) {}
        fn updating(m: Model, d: Decorator) {}
        fn updated(m: Model, d: Decorator) {}
        fn deleting(m: Model, d: Decorator) {}
        fn deleted(m: Model, d: Decorator) {}
        // After a soft delete actually marks the row (not for forceDelete).
        fn trashed(m: Model, d: Decorator) {}
        // Around forceDelete (a @SoftDeletes row removed for good); deleting/deleted
        // fire too, since a forceDelete is still a delete.
        fn forceDeleting(m: Model, d: Decorator) {}
        fn forceDeleted(m: Model, d: Decorator) {}
        // Around undoing a soft delete.
        fn restoring(m: Model, d: Decorator) {}
        fn restored(m: Model, d: Decorator) {}
        // After a row is read into a model.
        fn retrieved(m: Model, d: Decorator) {}
    }

    // A behavior a class wears: its name, the behavior, and the decorator.
    class BehaviorUse {
        public name: string
        public behavior: Behavior
        public decorator: Decorator
        constructor(name: string, behavior: Behavior, decorator: Decorator) { self.name = name; self.behavior = behavior; self.decorator = decorator; }
    }

    // The behaviors, by decorator name.
    class Behaviors {
        private static registry: HashMap<string, Behavior> = new HashMap<string, Behavior>()
        private static lock: Mutex = new Mutex()
        private static builtIn: bool = false

        // Puts `b` on every model class wearing `@<name>` (classes mapped before
        // this keep what they had: register behaviors at start-up).
        static fn register(name: string, b: Behavior) {
            Behaviors.lock.lock();
            Behaviors.registry.put(name, b);
            Behaviors.lock.unlock();
        }
        static fn isRegistered(name: string) -> bool {
            Behaviors.ensureBuiltIns();
            Behaviors.lock.lock();
            let yes = Behaviors.registry.containsKey(name);
            Behaviors.lock.unlock();
            return yes;
        }
        // The behaviors `info`'s class wears: its decorators that name one, and its base classes'.
        static fn on(info: ClassInfo) -> Array<BehaviorUse> {
            Behaviors.ensureBuiltIns();
            let out = new Array<BehaviorUse>();
            let seen = new HashSet<string>();
            let c = info;
            Behaviors.lock.lock();
            while (c != null) {
                for (d in c.decorators()) {
                    let b = Behaviors.registry.getOr(d.name, null);
                    if (b != null && !seen.contains(d.name)) { seen.add(d.name); out.push(new BehaviorUse(d.name, b, d)); }
                }
                c = c.base();
            }
            Behaviors.lock.unlock();
            // Timestamps is on unless a class says @NoTimestamps.
            if (!seen.contains("Timestamps") && !info.has("NoTimestamps")) {
                out.push(new BehaviorUse("Timestamps", Behaviors.registry["Timestamps"], new Decorator("Timestamps")));
            }
            return out;
        }
        private static fn ensureBuiltIns() {
            Behaviors.lock.lock();
            if (!Behaviors.builtIn) {
                Behaviors.builtIn = true;
                if (!Behaviors.registry.containsKey("SoftDeletes")) { Behaviors.registry.put("SoftDeletes", new SoftDeletesBehavior()); }
                if (!Behaviors.registry.containsKey("Timestamps")) { Behaviors.registry.put("Timestamps", new TimestampsBehavior()); }
                if (!Behaviors.registry.containsKey("Uuids")) { Behaviors.registry.put("Uuids", new UuidsBehavior()); }
            }
            Behaviors.lock.unlock();
        }
    }

    // A model observer: the same hooks as a Behavior (saving, created, deleting,
    // ...), attached to a class by a call instead of a decorator:
    //
    //   class UserObserver extends Behavior {
    //       fn created(m: Model, d: Decorator) { Mail.send(...) }
    //   }
    //   User.observe(new UserObserver())           // runs for User, and any subclass
    //
    // `d` is a placeholder (its name is "Observer"): an observer has no decorator
    // of its own to read arguments from.
    class Observers {
        private static byClass: HashMap<string, Array<Behavior>> = new HashMap<string, Array<Behavior>>()
        private static lock: Mutex = new Mutex()
        // Set once anything is registered, so fire() can skip the lookup otherwise
        // (an approximate check across threads is fine: it only ever turns true).
        private static anyRegistered: bool = false

        // Whether any observer has been registered (fire()'s fast path).
        static fn any() -> bool { return Observers.anyRegistered; }
        // Makes `o`'s hooks run for the class named `classFq` and its subclasses.
        static fn register(classFq: string, o: Behavior) {
            Observers.anyRegistered = true;
            Observers.lock.lock();
            if (!Observers.byClass.containsKey(classFq)) { Observers.byClass.put(classFq, new Array<Behavior>()); }
            Observers.byClass[classFq].push(o);
            Observers.lock.unlock();
        }
        // The observers of `info`'s class: its own, and its base classes'.
        static fn of(info: ClassInfo) -> Array<Behavior> {
            let out = new Array<Behavior>();
            if (!Observers.anyRegistered) { return out; }
            Observers.lock.lock();
            let c: ClassInfo = info;
            while (c != null) {
                let list = Observers.byClass.getOr(c.name, null);
                if (list != null) { for (o in list) { out.push(o); } }
                c = c.base();
            }
            Observers.lock.unlock();
            return out;
        }
    }

    // @SoftDeletes, or @SoftDeletes("removedAt"): delete() marks the row (in a
    // `DateTime?` field, deletedAt by default) instead of removing it, and
    // queries leave marked rows out (withTrashed, onlyTrashed, restore, forceDelete).
    class SoftDeletesBehavior extends Behavior {
        fn scopes() -> bool { return false }   // (its condition comes from the query's trashed setting)
        fn boot(map: TableMap, d: Decorator) {
            let name = !d.args.isEmpty() ? d.text(0) : "deletedAt";
            let m = map.find(name);
            if (m == null || m.kind != "datetime") {
                throw new StateError(map.info.simpleName() + " is @SoftDeletes but has no `" + name + ": DateTime?` field");
            }
            m.nullable = true;
            map.softDelete = m;
        }
    }

    // Timestamps: createdAt and updatedAt (DateTime fields; or
    // @Timestamps("created", "updated")) are set on insert, and updatedAt on update.
    class TimestampsBehavior extends Behavior {
        fn scopes() -> bool { return false }
        fn boot(map: TableMap, d: Decorator) {
            let c = map.find(!d.args.isEmpty() ? d.text(0) : "createdAt");
            let u = map.find(d.args.size() > 1 ? d.text(1) : "updatedAt");
            if (c != null && c.kind == "datetime") { map.createdAt = c; }
            if (u != null && u.kind == "datetime") { map.updatedAt = u; }
        }
    }

    // @Uuids, or @Uuids("field"): a new row gets a random UUID (v4) in that
    // string field (uuid by default) when it is empty.
    class UuidsBehavior extends Behavior {
        fn scopes() -> bool { return false }
        fn creating(m: Model, d: Decorator) {
            let info = ClassInfo.of(m);
            let name = !d.args.isEmpty() ? d.text(0) : "uuid";
            let f = info.field(name);
            if (f == null) { throw new StateError(info.simpleName() + " is @Uuids but has no `" + name + ": string` field"); }
            let v = f.get(m);
            if (v == null || "${v}" == "") { f.set(m, Uuid.v4()); }
        }
    }
}
