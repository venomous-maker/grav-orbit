// migrations.grav — changes to the database kept as code, run once each, in
// order, and undone in reverse.
//
//   class CreatePosts extends Migration {
//       fn up() { Schema.create("posts", fn(t: Blueprint) { t.id(); t.varchar("title"); t.timestamps() }) }
//       fn down() { Schema.dropIfExists("posts") }
//   }
//
//   let m = new Migrator()
//   m.add(new CreateUsers()); m.add(new CreatePosts())
//   m.migrate()          // runs those not run yet, as one batch
//   m.rollback()         // undoes the last batch
//   m.status()           // ["CreateUsers: ran (batch 1)", "CreatePosts: pending"]
//
// Several servers may migrate the same database at once (a deploy starting
// them together): migrate, rollback, reset and refresh hold a lock while they
// work, so the others wait and then find nothing left to do. tryMigrate skips
// instead of waiting. The lock is MySQL's GET_LOCK, a PostgreSQL advisory
// lock (both let go if the process dies), or elsewhere a row in
// `<table>_lock` (taken over when its process has died, or after
// lockStaleSeconds). A unique index on the migration's name backs it up.
import "std"
import "grav-db"
import "db.grav"

namespace orbit {

    %{
    #include <errno.h>
    #include <signal.h>
    %}

    // One change to the database: up makes it, down undoes it.
    abstract class Migration {
        abstract fn up()
        abstract fn down()
        // Its name in the migrations table (its class name, by default).
        fn name() -> string { return ClassInfo.of(self).simpleName(); }
    }

    // Runs migrations and keeps track of them in the `migrations` table.
    class Migrator {
        private list: Array<Migration> = new Array<Migration>()
        private db: Connection = null
        public table: string = "migrations"
        // How long migrate (rollback, reset, refresh) waits for another process
        // that is migrating; then StateError.
        public lockWaitSeconds: int = 600
        // A lock row older than this is taken over, its process presumed gone
        // (where the database has no lock of its own: SQLite).
        public lockStaleSeconds: int = 3600
        private indexed: bool = false

        // Uses `db` instead of the default connection.
        fn on(db: Connection) -> Migrator { self.db = db; return self; }
        // Adds a migration (they run in the order added).
        fn add(m: Migration) -> Migrator { self.list.push(m); return self; }

        // Runs the migrations not run yet, as one batch; their names. Waits
        // while another process migrates.
        fn migrate() -> Array<string> {
            return self.exclusive(self.lockWaitSeconds, true, fn() -> Array<string> { return self.runPending(); });
        }
        // migrate, unless another process is migrating right now: then null.
        fn tryMigrate() -> Array<string> {
            return self.exclusive(0, false, fn() -> Array<string> { return self.runPending(); });
        }
        private fn runPending() -> Array<string> {
            let db = self.conn();
            let done = self.ran(db);
            let batch = self.lastBatch(db) + 1;
            let out = new Array<string>();
            for (m in self.list) {
                let name = m.name();
                if (done.containsKey(name)) { continue; }
                db.transaction(fn() {
                    self.using(fn() { m.up() });
                    let a = new Array<any>();
                    a.push(name);
                    a.push(batch);
                    db.execute("INSERT INTO " + db.quote(self.table) + " (" + db.quote("migration") + ", " + db.quote("batch") + ") VALUES (?, ?)", a);
                });
                out.push(name);
            }
            return out;
        }
        // Undoes the last `steps` batches, newest first; the names undone.
        fn rollback(steps: int = 1) -> Array<string> {
            return self.exclusive(self.lockWaitSeconds, true, fn() -> Array<string> { return self.undoBatches(steps); });
        }
        private fn undoBatches(steps: int) -> Array<string> {
            let db = self.conn();
            let out = new Array<string>();
            for (i in 0..steps) {
                let batch = self.lastBatch(db);
                if (batch == 0) { break; }
                let a = new Array<any>();
                a.push(batch);
                let names = new Array<string>();
                for (row in db.query("SELECT " + db.quote("migration") + " FROM " + db.quote(self.table) + " WHERE " + db.quote("batch") + " = ? ORDER BY " + db.quote("id") + " DESC", a)) {
                    names.push(row.getString("migration"));
                }
                for (n in names) { self.undo(db, n); out.push(n); }
            }
            return out;
        }
        // Undoes every migration run.
        fn reset() -> Array<string> {
            return self.exclusive(self.lockWaitSeconds, true, fn() -> Array<string> { return self.undoAll(); });
        }
        private fn undoAll() -> Array<string> {
            let out = new Array<string>();
            while (self.lastBatch(self.conn()) > 0) { for (n in self.undoBatches(1)) { out.push(n); } }
            return out;
        }
        // Undoes everything, then runs everything (under one lock).
        fn refresh() -> Array<string> {
            return self.exclusive(self.lockWaitSeconds, true, fn() -> Array<string> { self.undoAll(); return self.runPending(); });
        }
        // Each migration, "name: ran (batch n)" or "name: pending".
        fn status() -> Array<string> {
            let db = self.conn();
            self.prepare(db);
            let done = self.ran(db);
            let out = new Array<string>();
            for (m in self.list) {
                let n = m.name();
                out.push(done.containsKey(n) ? n + ": ran (batch ${done[n]})" : n + ": pending");
            }
            return out;
        }

        private fn conn() -> Connection { return self.db == null ? DB.connection() : self.db; }
        private fn prepare(db: Connection) {
            let d = db.driver();
            let id = d == "postgres" ? "BIGSERIAL PRIMARY KEY" : d == "mysql" ? "BIGINT AUTO_INCREMENT PRIMARY KEY" : "INTEGER PRIMARY KEY AUTOINCREMENT";
            db.exec("CREATE TABLE IF NOT EXISTS " + db.quote(self.table) + " (" + db.quote("id") + " " + id + ", " +
                db.quote("migration") + " VARCHAR(255) NOT NULL, " + db.quote("batch") + " INTEGER NOT NULL)");
            if (self.indexed) { return; }
            // No name recorded twice, should two processes get past the lock
            // (tables made before the index get it here; MySQL has no IF NOT
            // EXISTS for indexes, so there it fails once it exists, as it does
            // where duplicates already are).
            let index = db.quote(self.table + "_migration_unique");
            try {
                db.exec("CREATE UNIQUE INDEX " + (d == "mysql" ? "" : "IF NOT EXISTS ") + index + " ON " + db.quote(self.table) + " (" + db.quote("migration") + ")");
            } catch (e: Exception) {}   // (MySQL has no IF NOT EXISTS here: the index being there already is fine)
            self.indexed = true;
        }

        // ── the lock ──────────────────────────────────────────────────────────
        // `body`'s result, run holding the migration lock, waiting up to
        // `waitSeconds` for it; when it stays taken, StateError if `mustRun`,
        // else null (body skipped).
        private fn exclusive(waitSeconds: int, mustRun: bool, body: fn() -> Array<string>) -> Array<string> {
            let db = self.conn();
            self.prepare(db);
            if (!self.lock(db, waitSeconds)) {
                if (mustRun) { throw new StateError("another process has been migrating for ${waitSeconds} s (the migration lock is held)"); }
                return null;
            }
            try { return body(); } finally { self.unlock(db); }
        }
        private fn lockName() -> string { return "orbit:" + self.table; }
        private fn lock(db: Connection, waitSeconds: int) -> bool {
            let d = db.driver();
            let deadline = Time.monotonicMs() + (waitSeconds as long) * 1000;
            while (true) {
                if (self.tryLock(db, d)) { return true; }
                if (Time.monotonicMs() >= deadline) { return false; }
                Time.sleepMs(100);
            }
            return false;
        }
        private fn tryLock(db: Connection, d: string) -> bool {
            let a = new Array<any>();
            if (d == "mysql") {
                a.push(self.lockName());
                return Integer.parseOr("${db.queryValue("SELECT GET_LOCK(CONCAT(DATABASE(), '/', ?), 0)", a)}", 0) == 1;
            }
            if (d == "postgres") {
                a.push(Migrator.key(self.lockName()));
                return "${db.queryValue("SELECT pg_try_advisory_lock(?)", a)}" == "true";
            }
            let table = db.quote(self.table + "_lock");
            db.exec("CREATE TABLE IF NOT EXISTS " + table + " (" + db.quote("id") + " INTEGER PRIMARY KEY, " +
                db.quote("owner") + " VARCHAR(255) NOT NULL, " + db.quote("since") + " BIGINT NOT NULL)");
            a.push(Migrator.owner());
            a.push(Time.now());
            try {
                db.execute("INSERT INTO " + table + " (" + db.quote("id") + ", " + db.quote("owner") + ", " + db.quote("since") + ") VALUES (1, ?, ?)", a);
                return true;
            } catch (e: Exception) {}   // (another process holds the lock: the caller waits and tries again)
            // Taken: by a process that is gone (on this host), or for too long?
            let row = db.queryOne("SELECT " + db.quote("owner") + ", " + db.quote("since") + " FROM " + table + " WHERE " + db.quote("id") + " = 1");
            if (row == null) { return false; }
            let owner = row.getString("owner");
            let stale = Time.now() - row.getInt("since") > (self.lockStaleSeconds as long) || Migrator.ownerGone(owner);
            if (stale) {
                let b = new Array<any>();
                b.push(owner);
                db.execute("DELETE FROM " + table + " WHERE " + db.quote("id") + " = 1 AND " + db.quote("owner") + " = ?", b);
            }
            return false;
        }
        private fn unlock(db: Connection) {
            let d = db.driver();
            let a = new Array<any>();
            try {
                if (d == "mysql") { a.push(self.lockName()); db.queryValue("SELECT RELEASE_LOCK(CONCAT(DATABASE(), '/', ?))", a); return; }
                if (d == "postgres") { a.push(Migrator.key(self.lockName())); db.queryValue("SELECT pg_advisory_unlock(?)", a); return; }
                a.push(Migrator.owner());
                db.execute("DELETE FROM " + db.quote(self.table + "_lock") + " WHERE " + db.quote("id") + " = 1 AND " + db.quote("owner") + " = ?", a);
            } catch (e: Exception) {}   // (releasing a lock that is gone already is fine)
        }
        // This process, as a lock row names it: host:pid.
        private static fn owner() -> string { return OS.hostname() + ":${Process.pid()}"; }
        // Whether `owner` is a process on this host that no longer runs.
        private static fn ownerGone(owner: string) -> bool {
            let at = Str.lastIndexOf(owner, ":");
            if (at < 0 || owner[..at] != OS.hostname()) { return false; }
            let pid = Integer.parseOr(owner[at + 1..], 0) as int;
            if (pid <= 0) { return false; }
            return %{ (kill((pid_t)pid, 0) != 0 && errno == ESRCH) %} as bool;
        }
        // A 63-bit key for PostgreSQL's advisory locks (FNV-1a of the name).
        private static fn key(name: string) -> long {
            let h = %{ (unsigned long long)1469598103934665603ULL %} as long;
            for (i in 0..name.length) {
                let c = name[i] as int as long;
                h = %{ (long long)(((unsigned long long)h ^ (unsigned long long)c) * 1099511628211ULL) %} as long;
            }
            return %{ (long long)((unsigned long long)h & 0x7fffffffffffffffULL) %} as long;
        }
        private fn ran(db: Connection) -> HashMap<string, long> {
            let out = new HashMap<string, long>();
            for (row in db.query("SELECT " + db.quote("migration") + ", " + db.quote("batch") + " FROM " + db.quote(self.table))) {
                out.put(row.getString("migration"), row.getInt("batch"));
            }
            return out;
        }
        private fn lastBatch(db: Connection) -> long {
            let v = db.queryValue("SELECT MAX(" + db.quote("batch") + ") FROM " + db.quote(self.table));
            return v == null ? 0 : v is long ? v as long : Integer.parseOr("${v}", 0);
        }
        // Runs `body` with the Migrator's connection (on) as the default, for the migrations' Schema calls.
        private fn using(body: fn()) {
            if (self.db == null) { body(); return; }
            let before: Connection = DB.hasConnection() ? DB.connection() : null;
            DB.connect(self.db);
            try { body(); } finally { if (before != null) { DB.connect(before); } else { DB.disconnect(); } }
        }
        private fn undo(db: Connection, name: string) {
            let found: Migration = null;
            for (m in self.list) { if (m.name() == name) { found = m; } }
            if (found == null) { throw new StateError("migration '" + name + "' was run but is not in this Migrator"); }
            let m = found;
            db.transaction(fn() {
                self.using(fn() { m.down() });
                let a = new Array<any>();
                a.push(name);
                db.execute("DELETE FROM " + db.quote(self.table) + " WHERE " + db.quote("migration") + " = ?", a);
            });
        }
    }
}
