// mapping.grav — how a class maps to a table: its name, its columns, its id,
// and each column's SQL type for each database.
//
//   @Table("people")                    // default: the class name, snake_case, plural ("users")
//   class User extends Model {
//       @Id public id: long = 0         // default: a field called id; an integer id is numbered by the database
//       @Column("email_address", length: 255, unique: true)
//       public email: string = ""
//       public nickName: string? = null // column nick_name, NULL allowed (the `?`)
//       @Ignore public cache: string = ""
//   }
//
// Fields map to columns when they hold numbers, bools, strings, enums,
// DateTime, Decimal, Bytes, JsonValue or `any` (as `T?` too); fields holding
// other objects (lists, models) are not columns. @Column takes the column name
// first, then any of length, unique, precision, scale, type (the SQL type,
// as written) and nullable. On fields also: @Ignore (not a column), @Hidden
// (left out of toMap and toJson), @Guarded (not set by fill or create),
// @NotNull, @Unique, @Cast("name") (a field of any type, stored through a
// registered Cast: casts.grav). On classes: @Table("name"), @SoftDeletes (needs a
// `deletedAt: DateTime?` field), @NoTimestamps (createdAt and updatedAt fields
// are otherwise filled in on save), @Connection("name") (a DB connection by
// name), @MorphName("post") (its name in polymorphic relations; the class name
// otherwise).
import "std"
import "grav-db"
import "behaviors.grav"
import "casts.grav"

namespace orbit {

    // Turning names into table and column names.
    class Naming {
        // "createdAt" -> "created_at", "HTTPServer" -> "http_server", "OrderItem" -> "order_item".
        static fn snake(name: string) -> string {
            let out = new StringBuilder();
            let n = name.length;
            for (i in 0..n) {
                let c = name[i];
                let upper = c.isUpper();
                if (upper && i > 0) {
                    let prevLower = name[i - 1].isLower() || name[i - 1].isDigit();
                    let nextLower = i + 1 < n && name[i + 1].isLower();
                    if (prevLower || (nextLower && name[i - 1].isUpper())) { out.append("_"); }
                }
                out.append(upper ? c.toLower().toChar() : c.toChar());
            }
            return out.toString();
        }
        // English plurals for table names: "user" -> "users", "category" ->
        // "categories", "box" -> "boxes", "address" -> "addresses".
        static fn plural(word: string) -> string {
            let n = word.length;
            if (n == 0) { return word; }
            if (word.endsWith("y") && n > 1 && !Naming.isVowel(word[n - 2])) { return word[..n - 1] + "ies"; }
            if (word.endsWith("s") || word.endsWith("x") || word.endsWith("z") || word.endsWith("ch") || word.endsWith("sh")) { return word + "es"; }
            return word + "s";
        }
        private static fn isVowel(c: byte) -> bool {
            let l = c.toLower();
            return l == ('a' as byte) || l == ('e' as byte) || l == ('i' as byte) || l == ('o' as byte) || l == ('u' as byte);
        }
    }

    // The moments in a model's life that behaviors and observers hear about.
    enum ModelHook { Saving, Saved, Creating, Created, Updating, Updated, Deleting, Deleted, Trashed, ForceDeleting, ForceDeleted, Restoring, Restored, Retrieved }

    // One mapped field: its column and what the column is like.
    class FieldMap {
        public field: FieldInfo
        public column: string
        // "int", "long", "float", "bool", "string", "datetime", "decimal", "bytes", "json", "enum" or "any".
        public kind: string
        public isId: bool = false
        // The database numbers it (an integer id, unless @Id(auto: false)).
        public auto: bool = false
        public nullable: bool = false
        public unique: bool = false
        public length: int = 0
        public precision: int = 0
        public scale: int = 0
        // @Column(type: "...") as written ("" to let Orbit choose).
        public sqlType: string = ""
        // Left out of toMap and toJson (@Hidden); not set by fill and create (@Guarded, and a numbered id).
        public hidden: bool = false
        public guarded: bool = false
        // Its place in TableMap.fields (a model's snapshot keeps values by it).
        public index: int = 0
        // @Cast("name"): how its value goes into the column and back (null: as it is).
        public cast: Cast = null
        // `kind` worked out once, for reading rows: 1 decimal, 2 json, 3 datetime
        // (a column value that may need converting), 4 string, 5 int or long (one
        // whose column value is already what the field holds), 0 anything else.
        public code: int = 0

        constructor(field: FieldInfo, column: string, kind: string) {
            self.field = field;
            self.column = column;
            self.kind = kind;
            self.code = kind == "decimal" ? 1 : kind == "json" ? 2 : kind == "datetime" ? 3 :
                        kind == "string" ? 4 : kind == "int" || kind == "long" ? 5 : 0;
        }
        // The value its column gets from `obj` (through its cast).
        fn columnValue(obj: any) -> any {
            let v = self.field.get(obj);
            return self.cast == null || v == null ? v : self.cast.set(v);
        }
        // Sets the field from its column's value (through its cast).
        fn setFromColumn(obj: any, v: any) { self.field.set(obj, self.cast == null || v == null ? v : self.cast.get(v)); }
    }

    // A class's table: built once per class from its fields and decorators.
    class TableMap {
        public info: ClassInfo
        public table: string
        public fields: Array<FieldMap> = new Array<FieldMap>()
        // The id column (null when the class has none).
        public id: FieldMap = null
        // deletedAt with @SoftDeletes; createdAt and updatedAt filled in on save (null when not).
        public softDelete: FieldMap = null
        public createdAt: FieldMap = null
        public updatedAt: FieldMap = null
        // Its name in polymorphic relations, and the DB connection it uses ("" for the default).
        public morphName: string
        public connection: string = ""
        // The behaviors its class wears (behaviors.grav).
        public behaviors: Array<BehaviorUse> = new Array<BehaviorUse>()
        // Properties put into toMap and toJson (`@Appended get x()`, or @Appends("x", ...) on the class).
        public appends: Array<PropertyInfo> = new Array<PropertyInfo>()
        // `@Touches("post", ...)`: relation methods (belongsTo, hasOne, morphOne,
        // morphTo) whose single related object is touched after this class saves.
        public touches: Array<string> = new Array<string>()
        private byName: HashMap<string, FieldMap> = new HashMap<string, FieldMap>()

        private static cache: HashMap<string, TableMap> = new HashMap<string, TableMap>()
        private static morphs: HashMap<string, ClassInfo> = new HashMap<string, ClassInfo>()
        private static lock: Mutex = new Mutex()

        constructor(info: ClassInfo) {
            self.info = info;
            let t = info.decorator("Table");
            self.table = t != null && t.text(0) != "" ? t.text(0) : Naming.plural(Naming.snake(info.simpleName()));
            let mn = info.decorator("MorphName");
            self.morphName = mn != null ? mn.text(0) : info.simpleName();
            let cn = info.decorator("Connection");
            if (cn != null) { self.connection = cn.text(0); }
            let explicitId = false;
            for (f in info.fields()) { if (f.has("Id")) { explicitId = true; } }
            for (f in info.fields()) {
                if (f.has("Ignore")) { continue; }
                let kind = TableMap.kindOf(f);
                let cd = f.decorator("Cast");
                let cast: Cast = null;
                if (cd != null) {
                    cast = Casts.find(cd.text(0));
                    if (cast == null) { throw new StateError(info.simpleName() + "." + f.name + " is @Cast(\"" + cd.text(0) + "\"), and no cast has that name: Casts.register it first"); }
                    kind = cast.column();
                }
                if (kind == "") { continue; }
                let c = f.decorator("Column");
                let column = c != null && c.args.size() > 0 && c.keys[0] == "" ? c.text(0) : Naming.snake(f.name);
                let m = new FieldMap(f, column, kind);
                m.nullable = f.isNullable() || (c != null && c.flag("nullable", false));
                if (f.has("NotNull")) { m.nullable = false; }
                if (c != null) {
                    m.unique = c.flag("unique", false);
                    m.length = c.number("length", 0) as int;
                    m.precision = c.number("precision", 0) as int;
                    m.scale = c.number("scale", 0) as int;
                    m.sqlType = c.text("type");
                }
                if (f.has("Unique")) { m.unique = true; }
                m.hidden = f.has("Hidden");
                m.guarded = f.has("Guarded");
                let id = f.decorator("Id");
                if (id != null || (!explicitId && f.name == "id")) {
                    m.isId = true;
                    m.auto = (kind == "int" || kind == "long") && (id == null || id.flag("auto", true));
                    m.nullable = false;
                    if (m.auto) { m.guarded = true; }
                    self.id = m;
                }
                m.cast = cast;
                m.index = self.fields.size();
                self.fields.push(m);
                self.byName.put(f.name, m);
                if (!self.byName.containsKey(column)) { self.byName.put(column, m); }
            }
            let touchesDeco = info.decorator("Touches");
            if (touchesDeco != null) { for (a in touchesDeco.args) { self.touches.push("${a}"); } }
            // Properties in toMap: those marked @Appended, and those @Appends names.
            let named = new HashSet<string>();
            let c: ClassInfo = info;
            while (c != null) {
                let ap = c.decorator("Appends");
                if (ap != null) { for (a in ap.args) { named.add("${a}"); } }
                c = c.base();
            }
            for (p in info.properties()) {
                if ((p.has("Appended") || named.contains(p.name)) && p.canGet() && !p.isStatic()) { self.appends.push(p); named.remove(p.name); }
            }
            for (n in named.toArray()) { throw new StateError(info.simpleName() + " @Appends \"" + n + "\", and it has no such property: write `get " + n + "() -> T { ... }`"); }
            // Its behaviors (decorators naming one: @SoftDeletes, yours), each booted once.
            self.behaviors = Behaviors.on(info);
            for (u in self.behaviors) { u.behavior.boot(self, u.decorator); }
        }
        private static noDeco: Decorator = new Decorator("Observer")
        // Runs hook `hook` of each behavior on `obj` (a Model), then of each
        // observer registered for its class (Observers.of).
        fn fire(hook: ModelHook, obj: any) {
            if (self.behaviors.isEmpty() && !Observers.any()) { return; }   // (the usual case for every loaded row)
            if (!(obj is Model)) { return; }
            let m = obj as Model;
            for (u in self.behaviors) { TableMap.run(hook, u.behavior, m, u.decorator); }
            if (Observers.any()) { for (o in Observers.of(self.info)) { TableMap.run(hook, o, m, TableMap.noDeco); } }
        }
        // The same, by the hook's name ("saving", "created", ...).
        fn fire(hook: string, obj: any) {
            switch (hook) {
                case "saving": self.fire(ModelHook.Saving, obj)
                case "saved": self.fire(ModelHook.Saved, obj)
                case "creating": self.fire(ModelHook.Creating, obj)
                case "created": self.fire(ModelHook.Created, obj)
                case "updating": self.fire(ModelHook.Updating, obj)
                case "updated": self.fire(ModelHook.Updated, obj)
                case "deleting": self.fire(ModelHook.Deleting, obj)
                case "deleted": self.fire(ModelHook.Deleted, obj)
                case "trashed": self.fire(ModelHook.Trashed, obj)
                case "forceDeleting": self.fire(ModelHook.ForceDeleting, obj)
                case "forceDeleted": self.fire(ModelHook.ForceDeleted, obj)
                case "restoring": self.fire(ModelHook.Restoring, obj)
                case "restored": self.fire(ModelHook.Restored, obj)
                case "retrieved": self.fire(ModelHook.Retrieved, obj)
                default: throw new ValueError("no behavior hook '" + hook + "'")
            }
        }
        private static fn run(hook: ModelHook, b: Behavior, m: Model, d: Decorator) {
            switch (hook) {
                case ModelHook.Saving: b.saving(m, d)
                case ModelHook.Saved: b.saved(m, d)
                case ModelHook.Creating: b.creating(m, d)
                case ModelHook.Created: b.created(m, d)
                case ModelHook.Updating: b.updating(m, d)
                case ModelHook.Updated: b.updated(m, d)
                case ModelHook.Deleting: b.deleting(m, d)
                case ModelHook.Deleted: b.deleted(m, d)
                case ModelHook.Trashed: b.trashed(m, d)
                case ModelHook.ForceDeleting: b.forceDeleting(m, d)
                case ModelHook.ForceDeleted: b.forceDeleted(m, d)
                case ModelHook.Restoring: b.restoring(m, d)
                case ModelHook.Restored: b.restored(m, d)
                case ModelHook.Retrieved: b.retrieved(m, d)
            }
        }
        // Whether it wears behavior `name`.
        fn wears(name: string) -> bool { for (u in self.behaviors) { if (u.name == name) { return true; } } return false; }

        // The mapping of `info`'s class (made the first time, then shared).
        static fn of(info: ClassInfo) -> TableMap {
            TableMap.lock.lock();
            let m = TableMap.cache.getOr(info.name, null);
            if (m == null) {
                try { m = new TableMap(info); } catch (e: Exception) { TableMap.lock.unlock(); throw e; }
                TableMap.cache.put(info.name, m);
                if (!TableMap.morphs.containsKey(m.morphName)) { TableMap.morphs.put(m.morphName, info); }
            }
            TableMap.lock.unlock();
            return m;
        }
        // The class a polymorphic relation's type column names (`Post`), or null when
        // no mapped class has that name yet (see Orbit.morphMap).
        static fn morphed(name: string) -> ClassInfo {
            TableMap.lock.lock();
            let info = TableMap.morphs.getOr(name, null);
            TableMap.lock.unlock();
            return info;
        }
        // Registers `info` under `name` for polymorphic relations.
        static fn registerMorph(name: string, info: ClassInfo) {
            TableMap.lock.lock();
            TableMap.morphs.put(name, info);
            TableMap.lock.unlock();
        }

        // The field mapped by field name or column name, or null.
        fn find(name: string) -> FieldMap { return self.byName.getOr(name, null); }
        // The column for `name`: a field's column, or `name` itself (a column, or an expression).
        fn column(name: string) -> string { let m = self.find(name); return m == null ? name : m.column; }
        // The id, or a StateError naming the class (for find, save, delete).
        fn requireId() -> FieldMap {
            if (self.id == null) { throw new StateError(self.info.simpleName() + " has no id: mark a field @Id, or call one id"); }
            return self.id;
        }

        // The column kind of a field's type ("" when it is not a column).
        static fn kindOf(f: FieldInfo) -> string {
            let t = f.typeName;
            if (Str.endsWith(t, "?")) { t = t[..t.length - 1]; }
            if (f.isEnum()) { return "enum"; }
            switch (t) {
                case "int", "byte", "short", "uint", "ushort", "int8", "int16", "int32", "uint8", "uint16", "uint32": return "int"
                case "long", "ulong", "int64", "uint64": return "long"
                case "float", "double", "float32", "float64": return "float"
                case "bool": return "bool"
                case "string": return "string"
                case "any": return "any"
            }
            let simple = Str.lastIndexOf(t, ".") >= 0 ? t[Str.lastIndexOf(t, ".") + 1..] : t;
            switch (simple) {
                case "DateTime": return "datetime"
                case "Decimal": return "decimal"
                case "Bytes": return "bytes"
                case "JsonValue": return "json"
                default: return ""
            }
        }

        // The SQL type of a column for `driver` ("sqlite", "mysql", "postgres").
        static fn sqlType(m: FieldMap, driver: string) -> string {
            if (m.sqlType != "") { return m.sqlType; }
            let my = driver == "mysql";
            let pg = driver == "postgres";
            if (m.isId && m.auto) {
                if (pg) { return m.kind == "long" ? "BIGSERIAL" : "SERIAL"; }
                if (my) { return (m.kind == "long" ? "BIGINT" : "INT") + " UNSIGNED AUTO_INCREMENT"; }   // (as Blueprint.id: foreignId matches it)
                return "INTEGER";                                    // (SQLite: the rowid)
            }
            switch (m.kind) {
                case "int", "enum": return my ? "INT" : "INTEGER"
                case "long": return driver == "sqlite" ? "INTEGER" : "BIGINT"
                case "float": return my ? "DOUBLE" : driver == "sqlite" ? "REAL" : "DOUBLE PRECISION"
                case "bool": return "BOOLEAN"
                case "string": return m.length > 0 ? "VARCHAR(${m.length})" : my && (m.unique || m.isId) ? "VARCHAR(255)" : "TEXT"   // (MySQL indexes no TEXT)
                case "datetime": return pg ? "TIMESTAMPTZ" : my ? "DATETIME(6)" : "DATETIME"
                case "decimal": return m.precision > 0 ? "DECIMAL(${m.precision}, ${m.scale})" : pg ? "NUMERIC" : my ? "DECIMAL(38, 10)" : "DECIMAL"
                case "bytes": return pg ? "BYTEA" : my ? "LONGBLOB" : "BLOB"
                case "json": return pg ? "JSONB" : "JSON"
                default: return "TEXT"
            }
        }
    }
}
